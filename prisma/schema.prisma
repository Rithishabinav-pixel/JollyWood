generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Offer {
  id         String    @id @default(cuid())
  image      String
  link       String
  order      Int       @default(0)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([order])
}

enum StoryImageType {
  SQUARE
  LANDSCAPE
}

model VisitorStoryContent {
  id          String   @id @default(cuid())
  name        String
  testimonial String
  link        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitorStoryImage {
  id        String         @id @default(cuid())
  image     String
  imageType StoryImageType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GalleryCategory {
  id         String                 @id @default(cuid())
  name       String                 @unique
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  images     GalleryImageCategory[]
}

model GalleryImage {
  id         String                 @id @default(cuid())
  image      String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  categories GalleryImageCategory[]

  @@index([createdAt])
}

model GalleryImageCategory {
  galleryImageId    String
  galleryCategoryId String
  galleryImage      GalleryImage    @relation(fields: [galleryImageId], references: [id], onDelete: Cascade)
  galleryCategory   GalleryCategory @relation(fields: [galleryCategoryId], references: [id], onDelete: Cascade)

  @@id([galleryImageId, galleryCategoryId])
  @@index([galleryCategoryId])
}

model Announcement {
  id         String    @id @default(cuid())
  text       String
  link       String
  isActive   Boolean   @default(true)
  order      Int       @default(0)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, order])
}

model ContactEnquiry {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  mobileNumber String
  email        String
  message      String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model CareerEnquiry {
  id                 String   @id @default(cuid())
  firstName          String
  lastName           String
  mobileNumber       String
  email              String
  currentDesignation String?
  relevantExperience String?
  resume             String?
  coverLetter        String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

model CorporateEnquiry {
  id           String    @id @default(cuid())
  name         String
  mobileNumber String
  email        String
  location     String?
  eventType    String?
  eventDate    DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}
